# Postgres.  Required — a missing value is an error, not a default.
DATABASE_URL=postgres://lian:lian@127.0.0.1:5432/lian_dev

# Model provider.  Q17: provider-agnostic; one default ships.  Keys are read
# from the environment and never stored in the database — api_key_pool holds
# only a reference to the variable name plus cooldown state (LESSONS §12).
LIAN_MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_2=

# The external ticker signs its calls to /api/tick (Q16).  Vercel Hobby cron
# runs roughly twice a day, which is not a reminder system.
LIAN_TICK_SECRET=
