# Postgres.  Required — a missing value is an error, not a default.
DATABASE_URL=postgres://lian:lian@127.0.0.1:5432/lian_dev

# Model provider.  Q17: provider-agnostic; one default ships.  Keys are read
# from the environment and never stored in the database — api_key_pool holds
# only a reference to the variable name plus cooldown state (LESSONS §12).
LIAN_MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_2=

# The external ticker signs its calls to /api/tick (Q16).  Vercel Hobby cron
# runs roughly twice a day, which is not a reminder system.
LIAN_TICK_SECRET=

# Web push (VAPID).  Generate once with:
#   node -e "import('./packages/push/src/index.ts').then(m=>console.log(m.generateVapidKeys()))"
# The public key is what the browser subscribes with; the private key never
# leaves the server.  Without them a proactive turn still runs and stores the
# message — it reports nowhereToSend rather than pretending it delivered.
LIAN_VAPID_PUBLIC_KEY=
LIAN_VAPID_PRIVATE_KEY=
# RFC 8292 requires a contact a push service can reach.
LIAN_VAPID_SUBJECT=mailto:ops@example.com

# Speech (TTS + transcription).  See packages/voice/src/providers/speech.ts
# for the three constraints this must satisfy.
LIAN_SPEECH_API_KEY=

# Embeddings.  Width must match the vector column in migration 0003 (1024).
LIAN_EMBEDDER_URL=
LIAN_EMBEDDER_API_KEY=
LIAN_EMBEDDER_MODEL=
