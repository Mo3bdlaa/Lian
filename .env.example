# The environment contract.
#
# Everything below is read in exactly one place — apps/server/src/config.ts —
# which reports EVERY problem at once rather than failing on the first, and
# distinguishes what is required in production from what merely degrades in
# development. `apps/server/src/config.test.ts` is that contract as tests.
#
# Copy to .env and fill in. `npm run up` reads it.

# ── required everywhere ───────────────────────────────────────────────────
# The one value with no degraded mode: there is nowhere to put anything.
DATABASE_URL=postgres://lian:lian@127.0.0.1:5432/lian_dev

# ── required in production, degraded in development ───────────────────────
# Model provider.  Q17: provider-agnostic; one default ships.  Keys are read
# from the environment and never stored in the database — api_key_pool holds
# only a reference to the variable name plus cooldown state (LESSONS §12).
LIAN_MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# A second key lets one cooling down not stop her talking.
ANTHROPIC_API_KEY_2=

# The external ticker signs its calls to /api/tick (Q16).  Without it nothing
# proactive runs: /api/tick refuses every call.  Any long random string.
LIAN_TICK_SECRET=

# Web push (VAPID).  Generate once with:
#   node -e "import('./packages/push/src/index.ts').then(m=>console.log(m.generateVapidKeys()))"
# The public key is what the browser subscribes with; the private key never
# leaves the server.  Without them a proactive turn still runs and stores the
# message — it reports nowhereToSend rather than pretending it delivered.
LIAN_VAPID_PUBLIC_KEY=
LIAN_VAPID_PRIVATE_KEY=
# RFC 8292 requires a contact a push service can reach.
LIAN_VAPID_SUBJECT=mailto:ops@example.com

# Embeddings.  Width must match the vector column in migration 0003 (1024).
# Without them retrieval falls back to a deterministic embedder: it matches
# repeated text and misses paraphrase, which is the case memory exists for.
LIAN_EMBEDDER_MODEL=
LIAN_EMBEDDER_API_KEY=
LIAN_EMBEDDER_URL=

# Object storage, S3-compatible (S3, R2, B2, MinIO, Garage).  All four or
# none: a half-configured bucket is treated as no bucket.  Without them,
# photographs and voice notes have nowhere to live — receipts cannot be
# captured and voice notes fall back to text.  In development with none set,
# an in-process store is used: it works, and the objects live as long as the
# process does.
LIAN_STORAGE_BUCKET=
LIAN_STORAGE_ENDPOINT=
LIAN_STORAGE_ACCESS_KEY_ID=
LIAN_STORAGE_SECRET_ACCESS_KEY=
# 'auto' suits R2 and most S3-compatible services; S3 proper wants its region.
LIAN_STORAGE_REGION=auto

# Email. Both values or neither — with one of them every send fails at the
# provider rather than being skipped, which is worse, because the app then
# believes it has a transport.
#
# Without it: a password reset and a new-device confirmation are both CREATED
# and neither is delivered, so anyone who forgets their password is locked
# out. The rows are real, so adding a transport later loses nothing.
#
# LIAN_EMAIL_FROM may be "a@b.c" or "Name <a@b.c>". Its DOMAIN has to be
# verified with the provider, and that — not the key — is the commonest reason
# a first send fails. `npm run preflight email` says which of the two it was.
LIAN_EMAIL_API_KEY=
LIAN_EMAIL_FROM=

# Billing (UI-UX §18).  All three or none — with SOME of them set the config
# refuses to start, because that is the shape where checkout succeeds and
# nothing ever marks the account paid.  The webhook secret is the endpoint
# secret from the Stripe dashboard, not the API key: it is what authenticates
# the one request nobody here initiates.
#
# The webhook endpoint is POST /api/stripe/webhook and it needs these four
# events: checkout.session.completed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted.
LIAN_STRIPE_SECRET_KEY=
LIAN_STRIPE_PRICE_ID=
LIAN_STRIPE_WEBHOOK_SECRET=

# ── optional ──────────────────────────────────────────────────────────────
# Speech (TTS + transcription).  See packages/voice/src/providers/speech.ts
# for the three constraints this must satisfy.  Unset: voice is unavailable
# and text is unaffected.
LIAN_SPEECH_API_KEY=

# Where the app is served from.  Used for the confirmation link and the
# notification URL, and it decides whether cookies are Secure.  Must be https
# in production: service workers, web push and Secure cookies all require it.
LIAN_PUBLIC_URL=http://localhost:8787
PORT=8787
NODE_ENV=development

# How often the external ticker calls /api/tick.  Five minutes is the
# production default; every job it runs is idempotent, so more often is
# wasteful rather than dangerous.
LIAN_TICK_INTERVAL_SECONDS=300

# ── local development only ────────────────────────────────────────────────
# Prints the device-confirmation link to the server log instead of emailing
# it (there is no email transport wired yet).  Refused in production, where
# it would be a second way to obtain a session.
LIAN_LOG_CONFIRMATION_LINKS=

# The bare hostname Caddy obtains a TLS certificate for. Same host as
# LIAN_PUBLIC_URL without the scheme — Caddy wants a name, the app wants a
# URL. DNS must already point at the box before the first start.
LIAN_DOMAIN=

# Encrypts the daily database dump before it goes to R2 (AES-256-GCM).
#   npm run keys backup
# LOSING THIS LOSES THE BACKUPS — there is no recovery path, and that is what
# it is for: the bucket holds ciphertext it cannot read. Keep a copy somewhere
# that is neither this box nor that bucket.
LIAN_BACKUP_KEY=
