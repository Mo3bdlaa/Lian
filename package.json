{
  "name": "lian",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "migrate": "node tools/migrate.ts",
    "test:ci": "node tools/ci-test.ts",
    "test": "node --test --test-concurrency=1 \"packages/**/*.test.ts\" \"apps/**/*.test.ts\" \"tools/**/*.test.ts\"",
    "gate:boundaries": "node tools/gates/boundaries.ts",
    "gate:tokens:audit": "node tools/gates/tokens-audit.ts",
    "gate:tokens:raw": "node tools/gates/tokens-raw.ts",
    "gate:tokens:contrast": "node tools/gates/tokens-contrast.ts",
    "gate:tokens:tap": "node tools/gates/tokens-tap.ts",
    "gate:theme": "node tools/gates/theme-single-writer.ts",
    "gate:arabic": "node tools/gates/arabic-address.ts",
    "gate:wired": "node tools/gates/wired.ts",
    "gate:promises": "node tools/gates/promises.ts",
    "gate:formatting": "node tools/gates/formatting.ts",
    "gate:lessons": "node tools/gates/lessons-index.ts",
    "gates": "npm run gate:boundaries && npm run gate:analysis && npm run gate:db:scoping && npm run gate:db:paging && npm run gate:tokens:audit && npm run gate:tokens:raw && npm run gate:tokens:contrast && npm run gate:tokens:tap && npm run gate:theme && npm run gate:voice && npm run gate:arabic && npm run gate:wired && npm run gate:promises && npm run gate:formatting && npm run gate:lessons",
    "verify": "npm run typecheck && npm run gates && npm run test",
    "db:up": "node tools/db/up.ts",
    "db:migrate": "node tools/db/migrate.ts",
    "gate:db:scoping": "node tools/gates/db-scoping.ts",
    "gate:db:paging": "node tools/gates/db-paging.ts",
    "gate:voice": "node tools/gates/voice-cache.ts",
    "gate:analysis": "node tools/gates/analysis-path.ts",
    "dev": "node apps/server/src/main.ts",
    "tick": "node apps/server/src/ticker.ts",
    "report:economics": "node tools/report/economics.ts",
    "report": "node tools/report/weekly.ts",
    "preflight": "node tools/preflight.ts",
    "shots": "node tools/shots/index.ts",
    "up": "node tools/up.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "pg": "^8.13.1"
  }
}
